{
  "timezone": "Asia/Hong_Kong",
  "dailyCheckins": {
    "min": 1,
    "max": 3
  },
  "retention": false,
  "databases": [
    {
      "id": "supabase",
      "type": "supabase",
      "name": "Supabase",
      "region": "Singapore",
      "url": "https://your-project.supabase.co",
      "key": "replace-with-server-side-secret-key"
    },
    {
      "id": "adb_jp",
      "type": "oracle",
      "name": "Oracle ADB Japan",
      "region": "Osaka",
      "url": "https://your-database.oraclecloudapps.com/ords/your_schema",
      "user": "your_schema",
      "password": "replace-with-password",
      "dailyCheckins": 2
    },
    {
      "id": "mysql_jp",
      "type": "mysql",
      "name": "MySQL Japan",
      "region": "Osaka",
      "binding": "MYSQL_JP"
    }
  ]
}
