[Unit]
Description=Cloudflare Tunnel for Japan MySQL keepalive
After=network-online.target keepalive-mysql.service
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/home/ubuntu/.local/bin/cloudflared tunnel --no-autoupdate run --token-file /home/ubuntu/.config/keepalive-mysql/tunnel-token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
