[Unit]
Description=Keepalive Db2 Cloudflare Tunnel
After=network-online.target keepalive-db2.service
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/home/ubuntu/.local/bin/cloudflared tunnel --no-autoupdate run --token-file /home/ubuntu/.config/keepalive-db2/tunnel.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
