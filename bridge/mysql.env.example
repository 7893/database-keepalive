# Japan uses mysql only. US MySQL is excluded from keepalive.
BRIDGE_SERVICES=mysql
BRIDGE_PORT=8173
MYSQL_HOST=your-mysql-host.example
MYSQL_PORT=3306
MYSQL_DATABASE=keepalive
MYSQL_USER=keepalive
MYSQL_PASSWORD=replace-with-dedicated-database-password
MYSQL_SSL_CA=/path/to/your-trusted-mysql-ca.pem
MYSQL_SSL_VERIFY_IDENTITY=true
MYSQL_SSL_STRICT=true
MYSQL_BRIDGE_TOKEN=replace-with-a-random-token-at-least-32-characters
