{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "database-keepalive",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "CONFIG"
    ]
  },
  "hyperdrive": [
    {
      "binding": "MYSQL_JP",
      "id": "ccda769ed9e64aafb8156462d2e5591b"
    }
  ]
}
