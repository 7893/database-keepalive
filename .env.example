# Credential/connection reference only. Edit config.yaml for application settings.
# Only enabled instances require credentials. Keep real values outside Git and image context.
TRIGGER_SECRET=replace-with-a-long-random-secret
SCHEDULER_TOKEN=replace-with-a-separate-long-random-secret
PUBLIC_ORIGIN=https://your-cloud-run-service.example

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret
OCI_ADB_US_URL=https://your-us-ords-endpoint.example
OCI_ADB_US_USER=replace-with-your-us-user
OCI_ADB_US_PASS=replace-with-your-us-password
OCI_ADB_JP_URL=https://your-jp-ords-endpoint.example
OCI_ADB_JP_USER=replace-with-your-jp-user
OCI_ADB_JP_PASS=replace-with-your-jp-password

DB2_HOST=your-db2-host.example
DB2_PORT=50001
DB2_DATABASE=bludb
DB2_USER=replace-with-your-db2-user
DB2_PASSWORD=replace-with-your-db2-password
DB2_CA_FILE=/app/vendor/db2-ca.pem

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=keepalive
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_SSL_CA=/tmp/mysql-ca.pem
MYSQL_CA_PEM=replace-with-the-full-pinned-CA-PEM
# Loopback tunnel cannot verify the remote certificate hostname.
MYSQL_SSL_VERIFY_IDENTITY=false
TUNNEL_SERVICE_HOSTNAME=your-mysql-tcp-host.example
TUNNEL_SERVICE_TOKEN_ID=replace-with-your-access-client-id
TUNNEL_SERVICE_TOKEN_SECRET=replace-with-your-access-client-secret
