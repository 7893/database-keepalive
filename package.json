{
  "name": "keepalive-worker",
  "version": "0.1.1",
  "description": "Cloudflare Worker for scheduled Supabase, Oracle, and IBM Db2 keepalive checks.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": "11.19.1"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run check:structure && npm run check:secrets",
    "check:structure": "node scripts/check-structure.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node test/run-tests.js"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  },
  "packageManager": "npm@11.19.1"
}
