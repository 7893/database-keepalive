{
  "name": "keepalive",
  "version": "0.1.1",
  "description": "Unified Cloud Run dashboard and scheduled database keepalive service.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": "11.19.1"
  },
  "scripts": {
    "build": "npm run check",
    "check": "npm run check:structure && npm run check:secrets",
    "check:structure": "node scripts/check-structure.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev": "node service/server.mjs",
    "deploy": "python3 service/deploy.py",
    "test": "node test/run-tests.js",
    "test:native": "python3 -B -m unittest discover -s native -p 'test_*.py' -v"
  },
  "devDependencies": {},
  "packageManager": "npm@11.19.1"
}
