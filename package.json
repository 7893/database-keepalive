{
  "name": "database-keepalive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "configure": "node scripts/configure.ts",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "wrangler types --check && tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "bootstrap": "npm run configure && wrangler deploy --secrets-file .secrets.local.json",
    "secrets:update": "npm run configure && wrangler secret bulk .secrets.local.json"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
